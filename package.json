{
  "name": "notes",
  "version": "1.0.0",
  "private": true,
  "description": "프론트엔드 개발 지식 및 업무 경험 문서",
  "scripts": {
    "best:dev": "pnpm --filter best-practices dev",
    "best:build": "pnpm --filter best-practices build",
    "best:preview": "pnpm --filter best-practices preview",
    "sillok:dev": "pnpm --filter dev-sillok dev",
    "sillok:build": "pnpm --filter dev-sillok build",
    "sillok:preview": "pnpm --filter dev-sillok preview",
    "wiki:dev": "pnpm --filter wiki dev",
    "wiki:build": "pnpm --filter wiki build",
    "wiki:preview": "pnpm --filter wiki preview",
    "build": "node .scripts/build.mjs",
    "preview": "npx serve dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "new:vitepress": "hygen vitepress new"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^25.0.3",
    "hygen": "^6.2.11",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
